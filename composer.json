{
    "name": "synergitech/laravel-multiconfig",
    "description": "Per-user settings repository system for Laravel",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/collections": "^12.0|^13.0",
        "illuminate/config": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/cache": "^12.0|^13.0",
        "symfony/console": "^7.2|^8.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6.10",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "autoload": {
        "psr-4": {
            "SynergiTech\\Multiconfig\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SynergiTech\\Multiconfig\\MulticonfigServiceProvider"
            ],
            "aliases": {
                "Setting": "SynergiTech\\Multiconfig\\Facades\\Setting"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    }
}
